<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="app.solstone.experiment.runtime">
  <application android:label="journal runtime experiment" android:debuggable="true" android:extractNativeLibs="true" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".JournalService" android:exported="false" android:process=":journal"/>
    <service android:name=".IsolatedService" android:exported="false" android:process=":isolated" android:isolatedProcess="true"/>
  </application>
</manifest>
