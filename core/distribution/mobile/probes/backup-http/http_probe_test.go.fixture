package main

import (
	"encoding/json"
	"flag"
	"os"
	"testing"
)

var httpProbeFixture = flag.String("http-probe-fixture", "", "explicit owned fixture")

func TestHTTPQualificationEntry(t *testing.T) {
	if *httpProbeFixture == "" {
		t.Fatal("explicit fixture required")
	}
	encoded, err := os.ReadFile(*httpProbeFixture)
	if err != nil {
		t.Fatal("fixture read failed")
	}
	defer zeroBytes(encoded)
	result := runHTTPProbe(encoded)
	output, _ := json.Marshal(result)
	t.Log(string(output))
	if result["passed"] != true {
		t.Fatal("HTTP qualification entry failed")
	}
}
