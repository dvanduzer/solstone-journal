#include "librestic_bridge.h"
#include <errno.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

static int join(char *out, size_t cap, const char *base, const char *name) {
    int size = snprintf(out, cap, "%s/%s", base, name);
    return size > 0 && (size_t)size < cap ? 0 : 1;
}
static int write_fixture(const char *path, const char *content) {
    FILE *file = fopen(path, "wb");
    if (!file) return 1;
    int failed = fwrite(content, 1, strlen(content), file) != strlen(content);
    return fclose(file) || failed;
}
static int call(restic_request *request, restic_result *result) {
    uint64_t id = 0;
    if (restic_bridge_start(request, &id) || !id) return 1;
    if (restic_bridge_wait(id, result) || restic_bridge_free(id)) return 1;
    return result->status != 0;
}
int main(int argc, char **argv) {
    if (argc != 2) return 1;
    char repo[4096], source[4096], workspace[4096], target[4096], path[4096];
    if (join(repo, sizeof(repo), argv[1], "selection-abi-repo") ||
        join(source, sizeof(source), argv[1], "selection-abi-source") ||
        join(workspace, sizeof(workspace), argv[1], "selection-abi-workspace") ||
        join(target, sizeof(target), argv[1], "selection-abi-restored")) return 2;
    if (mkdir(repo, 0700) || mkdir(source, 0700) || mkdir(workspace, 0700)) return 3;
    if (join(path, sizeof(path), source, "owner") || write_fixture(path, "owner bytes")) return 4;
    if (join(path, sizeof(path), source, "secret") || write_fixture(path, "synthetic excluded bytes")) return 5;
    if (join(path, sizeof(path), source, "owner-link") || symlink("owner", path)) return 6;

    char password[] = "selection-abi-synthetic-key";
    restic_request request = {0};
    request.operation = 1; request.password = password; request.password_len = (uint32_t)strlen(password);
    request.repo_path = repo; request.repo_path_len = (uint32_t)strlen(repo);
    restic_result *result = calloc(1, sizeof(*result));
    if (!result || call(&request, result)) return 7;
    uint64_t id = 123;
    char policy[] = "[\"secret\"]";
    if (restic_bridge_snapshot_v1_start(&request, workspace, (uint32_t)strlen(workspace), policy, (uint32_t)strlen(policy), &id) != 1 || id) return 8;
    request.operation = 4; request.source_path = source; request.source_path_len = (uint32_t)strlen(source);
    id = 123;
    if (restic_bridge_snapshot_v1_start(&request, workspace, (uint32_t)strlen(workspace), (char *)(uintptr_t)1, 8 * 1024 * 1024 + 1, &id) != 5 || id) return 9;
    id = 123;
    if (restic_bridge_snapshot_v1_start(&request, workspace, (uint32_t)strlen(workspace), NULL, 2, &id) != 1 || id) return 10;
    id = 123;
    if (restic_bridge_snapshot_v1_start(&request, workspace, (uint32_t)strlen(workspace), "[\"../secret\"]", 13, &id) != 1 || id) return 11;
    if (restic_bridge_snapshot_v1_start(NULL, NULL, 0, NULL, 0, NULL) != 1) return 12;

    restic_s3_request remote = {0}; remote.version = 1; remote.operation = 4;
    id = 123;
    if (restic_bridge_s3_snapshot_v1_start(&remote, (char *)(uintptr_t)1, 8 * 1024 * 1024 + 1, &id) != 5 || id) return 13;
    id = 123;
    if (restic_bridge_s3_snapshot_v1_start(&remote, policy, (uint32_t)strlen(policy), &id) != 1 || id) return 14;
    if (restic_bridge_s3_snapshot_v1_start(NULL, NULL, 0, NULL) != 1) return 15;

    id = 0;
    if (restic_bridge_snapshot_v1_start(&request, workspace, (uint32_t)strlen(workspace), policy, (uint32_t)strlen(policy), &id) || !id) return 16;
    memset(policy, 'x', strlen(policy));
    if (restic_bridge_wait(id, result) || result->status || strlen(result->snapshot_id) != 64 || restic_bridge_free(id)) return 17;
    char snapshot[65]; memcpy(snapshot, result->snapshot_id, sizeof(snapshot));
    request.operation = 6; request.restore_path = target; request.restore_path_len = (uint32_t)strlen(target);
    request.snapshot_id = snapshot; request.snapshot_id_len = 64;
    if (call(&request, result)) return 18;
    char restored[4096];
    if (join(restored, sizeof(restored), target, "selection-abi-source")) return 19;
    if (join(path, sizeof(path), restored, "owner")) return 20;
    FILE *file = fopen(path, "rb"); char content[12] = {0};
    if (!file) return 21;
    size_t size = fread(content, 1, sizeof(content), file);
    if (fclose(file) || size != 11 || memcmp(content, "owner bytes", 11)) return 22;
    if (join(path, sizeof(path), restored, "secret")) return 23;
    struct stat stat;
    if (lstat(path, &stat) == 0 || errno != ENOENT) return 24;
    if (join(path, sizeof(path), restored, "owner-link")) return 25;
    char link[16]; ssize_t length = readlink(path, link, sizeof(link));
    if (length != 5 || memcmp(link, "owner", 5)) return 26;
    free(result);
    return 0;
}
