index 0000000..2605d78
--- /dev/null
+++ b/internal/restorer/root_io.go
@@ -0,0 +1,393 @@
+//go:build darwin || ios || linux
+
+package restorer
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+
+	"github.com/restic/restic/internal/data"
+	"golang.org/x/sys/unix"
+)
+
+var (
+	errPathEscapes = errors.New("path escapes from parent")
+)
+
+var (
+	restoreWriteHookMu sync.Mutex
+	restoreWriteHook   func() error
+	restoreWriteOnce   sync.Once
+)
+
+// SetRestoreWriteHook sets an observation hook called once on the first rooted file or directory create.
+func SetRestoreWriteHook(hook func() error) {
+	restoreWriteHookMu.Lock()
+	restoreWriteHook = hook
+	restoreWriteOnce = sync.Once{}
+	restoreWriteHookMu.Unlock()
+}
+
+func triggerRestoreWriteHook() error {
+	var err error
+	restoreWriteHookMu.Lock()
+	hook := restoreWriteHook
+	restoreWriteHookMu.Unlock()
+	if hook != nil {
+		restoreWriteOnce.Do(func() {
+			err = hook()
+		})
+	}
+	return err
+}
+
+// openatParent resolves the parent directory descriptor of p relative to rootFD using O_NOFOLLOW.
+// It returns parentFD and the leaf component name. If parentFD != rootFD, closeParent must be called.
+func openatParent(rootFD int, p string) (int, string, func(), error) {
+	p = strings.TrimPrefix(filepath.Clean(p), "/")
+	if p == "." || p == "" {
+		return rootFD, ".", func() {}, nil
+	}
+	dir := filepath.Dir(p)
+	leaf := filepath.Base(p)
+	if dir == "." || dir == "" {
+		return rootFD, leaf, func() {}, nil
+	}
+
+	comps := strings.Split(dir, "/")
+	curFD := rootFD
+	for _, comp := range comps {
+		if comp == "" || comp == "." {
+			continue
+		}
+		if comp == ".." {
+			if curFD != rootFD {
+				_ = unix.Close(curFD)
+			}
+			return -1, "", nil, errPathEscapes
+		}
+		nextFD, err := unix.Openat(curFD, comp, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if curFD != rootFD {
+			_ = unix.Close(curFD)
+		}
+		if err != nil {
+			return -1, "", nil, err
+		}
+		curFD = nextFD
+	}
+
+	return curFD, leaf, func() {
+		if curFD != rootFD {
+			_ = unix.Close(curFD)
+		}
+	}, nil
+}
+
+func rootEnsureDir(res *Restorer, target string) error {
+	if res.opts.DryRun {
+		return nil
+	}
+	target = strings.TrimPrefix(filepath.Clean(target), "/")
+	if target == "." || target == "" {
+		return nil
+	}
+
+	if err := triggerRestoreWriteHook(); err != nil {
+		return err
+	}
+	if res.BeforeWrite != nil {
+		if err := res.BeforeWrite(); err != nil {
+			return err
+		}
+	}
+
+	fi, err := res.root.Lstat(target)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return fmt.Errorf("failed to check for directory: %w", err)
+	}
+	if err == nil && !fi.IsDir() {
+		if err := rootRemove(res.root, target); err != nil {
+			return fmt.Errorf("failed to remove stale item: %w", err)
+		}
+	}
+
+	return rootMkdirAll(res.root, target, 0700)
+}
+
+func rootMkdirAll(root *os.Root, target string, perm os.FileMode) error {
+	target = strings.TrimPrefix(filepath.Clean(target), "/")
+	if target == "." || target == "" {
+		return nil
+	}
+
+	rootFile, err := root.OpenFile(".", os.O_RDONLY, 0)
+	if err != nil {
+		return err
+	}
+	defer rootFile.Close()
+	rootFD := int(rootFile.Fd())
+
+	comps := strings.Split(target, "/")
+	curFD := rootFD
+	for _, comp := range comps {
+		if comp == "" || comp == "." {
+			continue
+		}
+		if comp == ".." {
+			if curFD != rootFD {
+				_ = unix.Close(curFD)
+			}
+			return errPathEscapes
+		}
+		mkdirErr := unix.Mkdirat(curFD, comp, uint32(perm))
+		if mkdirErr != nil && !errors.Is(mkdirErr, unix.EEXIST) {
+			if curFD != rootFD {
+				_ = unix.Close(curFD)
+			}
+			return mkdirErr
+		}
+		nextFD, openErr := unix.Openat(curFD, comp, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if curFD != rootFD {
+			_ = unix.Close(curFD)
+		}
+		if openErr != nil {
+			return openErr
+		}
+		curFD = nextFD
+	}
+	if curFD != rootFD {
+		_ = unix.Close(curFD)
+	}
+	return nil
+}
+
+func rootRemove(root *os.Root, p string) error {
+	p = strings.TrimPrefix(filepath.Clean(p), "/")
+	if p == "." || p == "" {
+		return nil
+	}
+	rootFile, err := root.OpenFile(".", os.O_RDONLY, 0)
+	if err != nil {
+		return err
+	}
+	defer rootFile.Close()
+	parentFD, leaf, closeParent, err := openatParent(int(rootFile.Fd()), p)
+	if err != nil {
+		return err
+	}
+	defer closeParent()
+
+	var stat unix.Stat_t
+	if err := unix.Fstatat(parentFD, leaf, &stat, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return err
+	}
+	if stat.Mode&unix.S_IFMT == unix.S_IFDIR {
+		return unix.Unlinkat(parentFD, leaf, unix.AT_REMOVEDIR)
+	}
+	return unix.Unlinkat(parentFD, leaf, 0)
+}
+
+func rootNodeCreateAt(res *Restorer, node *data.Node, target string) error {
+	rootFile, err := res.root.OpenFile(".", os.O_RDONLY, 0)
+	if err != nil {
+		return err
+	}
+	defer rootFile.Close()
+	parentFD, leaf, closeParent, err := openatParent(int(rootFile.Fd()), target)
+	if err != nil {
+		return err
+	}
+	defer closeParent()
+
+	switch node.Type {
+	case data.NodeTypeDir:
+		err = unix.Mkdirat(parentFD, leaf, uint32(node.Mode))
+		if err != nil && !errors.Is(err, unix.EEXIST) {
+			return err
+		}
+		return nil
+	case data.NodeTypeFile:
+		fd, err := unix.Openat(parentFD, leaf, unix.O_CREAT|unix.O_WRONLY|unix.O_TRUNC|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0600)
+		if err != nil {
+			return err
+		}
+		return unix.Close(fd)
+	case data.NodeTypeSymlink:
+		return unix.Symlinkat(node.LinkTarget, parentFD, leaf)
+	case data.NodeTypeDev:
+		return mknodSpecialAt(parentFD, leaf, syscall.S_IFBLK|0600, int(node.Device))
+	case data.NodeTypeCharDev:
+		return mknodSpecialAt(parentFD, leaf, syscall.S_IFCHR|0600, int(node.Device))
+	case data.NodeTypeFifo:
+		return mknodSpecialAt(parentFD, leaf, syscall.S_IFIFO|0600, 0)
+	case data.NodeTypeSocket:
+		return nil
+	default:
+		return fmt.Errorf("filetype %q not implemented", node.Type)
+	}
+}
+
+func rootRestoreHardlink(res *Restorer, node *data.Node, target, path string) error {
+	rootFile, err := res.root.OpenFile(".", os.O_RDONLY, 0)
+	if err != nil {
+		return err
+	}
+	defer rootFile.Close()
+	rootFD := int(rootFile.Fd())
+
+	parentTarget, leafTarget, closeTarget, err := openatParent(rootFD, target)
+	if err != nil {
+		return err
+	}
+	defer closeTarget()
+
+	parentPath, leafPath, closePath, err := openatParent(rootFD, path)
+	if err != nil {
+		return err
+	}
+	defer closePath()
+
+	return unix.Linkat(parentTarget, leafTarget, parentPath, leafPath, 0)
+}
+
+func rootRestoreMetadata(res *Restorer, node *data.Node, target string, warn func(msg string), xattrSelectFilter func(xattrName string) bool, ownershipByName bool) error {
+	rootFile, err := res.root.OpenFile(".", os.O_RDONLY, 0)
+	if err != nil {
+		return err
+	}
+	defer rootFile.Close()
+	parentFD, leaf, closeParent, err := openatParent(int(rootFile.Fd()), target)
+	if err != nil {
+		return err
+	}
+	defer closeParent()
+
+	// 1. Chown
+	if err := unix.Fchownat(parentFD, leaf, int(node.UID), int(node.GID), unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		if os.Geteuid() != 0 && (errors.Is(err, os.ErrPermission) || errors.Is(err, unix.EPERM)) {
+			// ignore permission error when not root
+		} else if errors.Is(err, unix.ENOTSUP) || errors.Is(err, unix.EOPNOTSUPP) {
+			// ignore unsupported
+		} else {
+			return err
+		}
+	}
+
+	// 2. Xattrs
+	isSymlink := node.Type == data.NodeTypeSymlink
+	for _, attr := range node.ExtendedAttributes {
+		if xattrSelectFilter != nil && !xattrSelectFilter(attr.Name) {
+			continue
+		}
+		_ = setXattrRoot(parentFD, leaf, isSymlink, attr.Name, attr.Value)
+	}
+
+	// 3. Timestamps
+	times := []unix.Timespec{
+		unix.NsecToTimespec(node.AccessTime.UnixNano()),
+		unix.NsecToTimespec(node.ModTime.UnixNano()),
+	}
+	_ = unix.UtimesNanoAt(parentFD, leaf, times, unix.AT_SYMLINK_NOFOLLOW)
+
+	// 4. Chmod (non-symlink)
+	if !isSymlink {
+		_ = unix.Fchmodat(parentFD, leaf, uint32(node.Mode&os.ModePerm), unix.AT_SYMLINK_NOFOLLOW)
+	}
+
+	return nil
+}
+
+func openRootFileCreate(root *os.Root, path string, createSize int64, sparse bool, allowRecursiveDelete bool) (*os.File, error) {
+	rootFile, err := root.OpenFile(".", os.O_RDONLY, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer rootFile.Close()
+	parentFD, leaf, closeParent, err := openatParent(int(rootFile.Fd()), path)
+	if err != nil {
+		return nil, err
+	}
+	defer closeParent()
+
+	fd, err := unix.Openat(parentFD, leaf, unix.O_CREAT|unix.O_WRONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0600)
+	if err != nil && errors.Is(err, os.ErrPermission) {
+		_ = unix.Fchmodat(parentFD, leaf, 0600, unix.AT_SYMLINK_NOFOLLOW)
+		fd, err = unix.Openat(parentFD, leaf, unix.O_WRONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0600)
+	}
+
+	var f *os.File
+	var fi os.FileInfo
+	if err == nil {
+		f = os.NewFile(uintptr(fd), path)
+		fi, err = f.Stat()
+		if err != nil {
+			_ = f.Close()
+			return nil, err
+		}
+	}
+
+	mustReplace := (f == nil) || !fi.Mode().IsRegular()
+	if !mustReplace {
+		if stat, ok := fi.Sys().(*syscall.Stat_t); ok && stat.Nlink > 1 {
+			mustReplace = true
+		}
+	}
+
+	if mustReplace {
+		if f != nil {
+			_ = f.Close()
+		}
+		_ = unix.Unlinkat(parentFD, leaf, 0)
+		_ = unix.Unlinkat(parentFD, leaf, unix.AT_REMOVEDIR)
+
+		newFD, openErr := unix.Openat(parentFD, leaf, unix.O_CREAT|unix.O_WRONLY|unix.O_EXCL|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0600)
+		if openErr != nil {
+			return nil, openErr
+		}
+		f = os.NewFile(uintptr(newFD), path)
+		fi, err = f.Stat()
+		if err != nil {
+			_ = f.Close()
+			return nil, err
+		}
+	}
+
+	return ensureSize(f, fi, createSize, sparse)
+}
+
+func openRootFileRead(root *os.Root, path string) (*os.File, error) {
+	rootFile, err := root.OpenFile(".", os.O_RDONLY, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer rootFile.Close()
+	parentFD, leaf, closeParent, err := openatParent(int(rootFile.Fd()), path)
+	if err != nil {
+		return nil, err
+	}
+	defer closeParent()
+
+	fd, err := unix.Openat(parentFD, leaf, unix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	f := os.NewFile(uintptr(fd), path)
+	fi, err := f.Stat()
+	if err != nil {
+		_ = f.Close()
+		return nil, err
+	}
+	if !fi.Mode().IsRegular() {
+		_ = f.Close()
+		return nil, fmt.Errorf("unexpected file type %v at %q", fi.Mode().Type(), path)
+	}
+	return f, nil
+}
diff --git a/internal/restorer/root_io_darwin.go b/internal/restorer/root_io_darwin.go
new file mode 100644
index 0000000..bc6dace
--- /dev/null
+++ b/internal/restorer/root_io_darwin.go
@@ -0,0 +1,33 @@
+//go:build darwin || ios
+
+package restorer
+
+import (
+	"errors"
+
+	"golang.org/x/sys/unix"
+)
+
+func setXattrRoot(parentFD int, leaf string, isSymlink bool, name string, val []byte) error {
+	var openFlags int = unix.O_RDONLY | unix.O_NOFOLLOW | unix.O_CLOEXEC
+	if isSymlink {
+		openFlags = unix.O_SYMLINK | unix.O_NOFOLLOW | unix.O_CLOEXEC
+	}
+	fd, err := unix.Openat(parentFD, leaf, openFlags, 0)
+	if err != nil {
+		fd, err = unix.Openat(parentFD, leaf, openFlags|unix.O_DIRECTORY, 0)
+		if err != nil {
+			return err
+		}
+	}
+	defer unix.Close(fd)
+	err = unix.Fsetxattr(fd, name, val, 0)
+	if err != nil && !errors.Is(err, unix.ENOTSUP) && !errors.Is(err, unix.EOPNOTSUPP) && !errors.Is(err, unix.EPERM) {
+		return err
+	}
+	return nil
+}
+
+func mknodSpecialAt(parentFD int, leaf string, mode uint32, dev int) error {
+	return unix.ENOTSUP
+}
diff --git a/internal/restorer/root_io_linux.go b/internal/restorer/root_io_linux.go
new file mode 100644
index 0000000..622cc0e
--- /dev/null
+++ b/internal/restorer/root_io_linux.go
@@ -0,0 +1,59 @@
+//go:build linux
+
+package restorer
+
+import (
+	"errors"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+func setXattrRoot(parentFD int, leaf string, isSymlink bool, name string, val []byte) error {
+	cname, err := unix.BytePtrFromString(name)
+	if err != nil {
+		return err
+	}
+	var valPtr *byte
+	if len(val) > 0 {
+		valPtr = &val[0]
+	}
+	if isSymlink {
+		fd, err := unix.Openat(parentFD, leaf, unix.O_PATH|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return err
+		}
+		defer unix.Close(fd)
+		empty := []byte{0}
+		_, _, errno := unix.Syscall6(
+			unix.SYS_SETXATTRAT,
+			uintptr(fd),
+			uintptr(unsafe.Pointer(&empty[0])),
+			uintptr(unsafe.Pointer(cname)),
+			uintptr(unsafe.Pointer(valPtr)),
+			uintptr(len(val)),
+			uintptr(unix.AT_EMPTY_PATH|unix.AT_SYMLINK_NOFOLLOW),
+		)
+		if errno != 0 && errno != unix.ENOTSUP && errno != unix.EOPNOTSUPP && errno != unix.EPERM {
+			return errno
+		}
+		return nil
+	}
+	fd, err := unix.Openat(parentFD, leaf, unix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		fd, err = unix.Openat(parentFD, leaf, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return err
+		}
+	}
+	defer unix.Close(fd)
+	err = unix.Fsetxattr(fd, name, val, 0)
+	if err != nil && !errors.Is(err, unix.ENOTSUP) && !errors.Is(err, unix.EOPNOTSUPP) && !errors.Is(err, unix.EPERM) {
+		return err
+	}
+	return nil
+}
+
+func mknodSpecialAt(parentFD int, leaf string, mode uint32, dev int) error {
+	return unix.Mknodat(parentFD, leaf, mode, dev)
+}
