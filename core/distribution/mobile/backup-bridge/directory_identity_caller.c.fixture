#include "librestic_bridge.h"
#include <fcntl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>
#if defined(__APPLE__)
#include <CoreFoundation/CoreFoundation.h>
#endif

static restic_result *result;
static int drain(uint64_t id) {
    int waited = restic_bridge_wait(id, result);
    int freed = restic_bridge_free(id);
    return waited || freed;
}
static int refuse_local(restic_request *request, restic_operation_options_v1 *options, int source, int workspace_fd, const char *workspace, const char *policy, uint32_t policy_len, int expected) {
    uint64_t id = 777;
    int status = restic_bridge_operation_directories_v1_start(request, options, source, workspace_fd, (char *)workspace, workspace ? (uint32_t)strlen(workspace) : 0, (char *)policy, policy_len, &id);
    int failed = status != expected || id != 0;
    if (id) { restic_bridge_cancel(id); drain(id); }
    return failed;
}
static int refuse_remote(restic_s3_request *request, restic_operation_options_v1 *options, int source, int state, int workspace, int expected) {
    uint64_t id = 777;
    int status = restic_bridge_s3_operation_directories_v1_start(request, options, source, state, workspace, NULL, 0, &id);
    int failed = status != expected || id != 0;
    if (id) { restic_bridge_cancel(id); drain(id); }
    return failed;
}
static int same_fd(int fd, const struct stat *before) {
    struct stat actual;
    return fstat(fd, &actual) == 0 && actual.st_dev == before->st_dev && actual.st_ino == before->st_ino;
}
static int run(restic_request *request, restic_operation_options_v1 *options, int source, int workspace_fd, const char *workspace, const char *policy) {
    uint64_t id = 0;
    int status = restic_bridge_operation_directories_v1_start(request, options, source, workspace_fd, (char *)workspace, workspace ? (uint32_t)strlen(workspace) : 0, (char *)policy, policy ? (uint32_t)strlen(policy) : 0, &id);
    return status || !id || drain(id) || result->status;
}
int main(int argc, char **argv) {
    if (argc != 2) return 1;
    char repo[4096], source[4096], workspace[4096], state[4096], other[4096], file[4096];
    if (snprintf(repo,sizeof(repo),"%s/directories-repo",argv[1]) >= (int)sizeof(repo) ||
        snprintf(source,sizeof(source),"%s/directories-source",argv[1]) >= (int)sizeof(source) ||
        snprintf(workspace,sizeof(workspace),"%s/directories-workspace",argv[1]) >= (int)sizeof(workspace) ||
        snprintf(state,sizeof(state),"%s/directories-state",argv[1]) >= (int)sizeof(state) ||
        snprintf(other,sizeof(other),"%s/directories-other",argv[1]) >= (int)sizeof(other) ||
        snprintf(file,sizeof(file),"%s/owner.txt",source) >= (int)sizeof(file)) return 2;
    if (mkdir(repo,0700) || mkdir(source,0700) || mkdir(workspace,0700) || mkdir(state,0700) || mkdir(other,0700)) return 3;
    FILE *out = fopen(file,"wb");
    if (!out || fwrite("owner bytes",1,11,out) != 11 || fclose(out)) return 4;
    int source_fd = open(source,O_RDONLY|O_DIRECTORY), workspace_fd = open(workspace,O_RDONLY|O_DIRECTORY);
    int state_fd = open(state,O_RDONLY|O_DIRECTORY), other_fd = open(other,O_RDONLY|O_DIRECTORY), regular_fd = open(file,O_RDONLY);
    struct stat source_before, workspace_before, state_before, other_before;
    if (source_fd < 0 || workspace_fd < 0 || state_fd < 0 || other_fd < 0 || regular_fd < 0 ||
        fstat(source_fd,&source_before) || fstat(workspace_fd,&workspace_before) || fstat(state_fd,&state_before) || fstat(other_fd,&other_before)) return 5;
    result = calloc(1,sizeof(*result)); if (!result) return 6;
    restic_request request = {.operation=1};
    request.repo_path=repo;request.repo_path_len=(uint32_t)strlen(repo);
    request.password="directories-daily-synthetic";request.password_len=(uint32_t)strlen(request.password);
    restic_operation_options_v1 options = {.version=1};
    if (run(&request,&options,-1,-1,NULL,NULL) || strlen(result->key_id)!=64) return 7;
    request.operation=3;request.recovery_password="directories-recovery-distinct";request.recovery_password_len=(uint32_t)strlen(request.recovery_password);
    if (run(&request,&options,-1,-1,NULL,NULL) || strlen(result->key_id)!=64) return 8;
    request.operation=2;request.password=request.recovery_password;request.password_len=request.recovery_password_len;
    request.recovery_password=NULL;request.recovery_password_len=0;
    if (run(&request,&options,-1,-1,NULL,NULL)) return 9;
    request.operation=4;request.source_path=source;request.source_path_len=(uint32_t)strlen(source);
    for (int which=0;which<4;which++) {
        int invalid = which==0 ? -1 : which==1 ? regular_fd : which==2 ? other_fd : source_fd;
        if (which<3 && refuse_local(&request,&options,invalid,workspace_fd,workspace,"[]",2,1)) return 10;
        if (refuse_local(&request,&options,source_fd,invalid,workspace,"[]",2,1)) return 11;
    }
    if (refuse_local(&request,&options,source_fd,workspace_fd,workspace,(const char *)(uintptr_t)1,8*1024*1024+1,5)) return 12;
    if (run(&request,&options,source_fd,workspace_fd,workspace,"[]") || strlen(result->snapshot_id)!=64) return 13;
    request.operation=5;request.source_path=NULL;request.source_path_len=0;
    if (run(&request,&options,-1,-1,NULL,NULL) || result->snapshot_count!=1) return 14;
    request.operation=7;options.check_read_mode=1;
    if (run(&request,&options,-1,-1,NULL,NULL)) return 15;
    if (refuse_local(&request,&options,source_fd,-1,NULL,NULL,0,1) || refuse_local(&request,&options,-1,workspace_fd,NULL,NULL,0,1)) return 16;
    options.version=2;
    if (refuse_local(&request,&options,-1,-1,NULL,NULL,0,1)) return 17;
    options.version=1;options.reserved1=1;
    if (refuse_local(&request,&options,-1,-1,NULL,NULL,0,1)) return 18;
    options.reserved1=0;options.retry_lock_ms=UINT64_MAX;
    if (refuse_local(&request,&options,-1,-1,NULL,NULL,0,5)) return 19;
    options=(restic_operation_options_v1){.version=1};
    for (int operation=6;operation<=9;operation++) {
        if (operation==7) continue;
        request.operation=operation;
        if (refuse_local(&request,&options,-1,-1,NULL,NULL,0,1)) return 20;
    }
    restic_s3_request remote={.version=1,.operation=2};
    remote.endpoint="https://backup.invalid";remote.endpoint_len=(uint32_t)strlen(remote.endpoint);
    remote.region="us-east-1";remote.region_len=(uint32_t)strlen(remote.region);
    remote.bucket="directories-fixture";remote.bucket_len=(uint32_t)strlen(remote.bucket);
    remote.prefix="caller";remote.prefix_len=(uint32_t)strlen(remote.prefix);
    remote.access_key="synthetic-access";remote.access_key_len=(uint32_t)strlen(remote.access_key);
    remote.secret_key="synthetic-secret";remote.secret_key_len=(uint32_t)strlen(remote.secret_key);
    remote.password=request.password;remote.password_len=request.password_len;
    remote.state_path=state;remote.state_path_len=(uint32_t)strlen(state);
    for (int which=0;which<3;which++) {
        int invalid=which==0 ? -1 : which==1 ? regular_fd : other_fd;
        if (refuse_remote(&remote,&options,-1,invalid,-1,1)) return 21;
    }
    if (refuse_remote(&remote,&options,source_fd,state_fd,-1,1) || refuse_remote(&remote,&options,-1,state_fd,workspace_fd,1)) return 22;
    remote.operation=8;remote.password=NULL;remote.password_len=0;
    if (refuse_remote(&remote,&options,-1,state_fd,-1,1)) return 23;
    remote.operation=6;
    if (refuse_remote(&remote,&options,-1,state_fd,-1,1)) return 24;
    if (restic_bridge_operation_directories_v1_start(NULL,NULL,-1,-1,NULL,0,NULL,0,NULL)!=1 ||
        restic_bridge_s3_operation_directories_v1_start(NULL,NULL,-1,-1,-1,NULL,0,NULL)!=1) return 25;
    /* Actual matching S3 admission; cancellation joins the .invalid synthetic
       endpoint. No live provider or usable credential is involved. */
#if defined(__APPLE__)
    CFURLRef url=CFURLCreateFromFileSystemRepresentation(NULL,(const UInt8 *)state,strlen(state),true);
    CFErrorRef error=NULL;
    if (!url || !CFURLSetResourcePropertyForKey(url,kCFURLIsExcludedFromBackupKey,kCFBooleanTrue,&error)) return 26;
    CFRelease(url);
#endif
    remote.operation=2;remote.password=request.password;remote.password_len=request.password_len;
    uint64_t id=0;
    if (restic_bridge_s3_operation_directories_v1_start(&remote,&options,-1,state_fd,-1,NULL,0,&id) || !id) return 27;
    if (restic_bridge_cancel(id) || drain(id)) return 28;
    if (!same_fd(source_fd,&source_before) || !same_fd(workspace_fd,&workspace_before) || !same_fd(state_fd,&state_before)) return 29;
    /* Standalone C reuse control. Deterministic held-worker reuse is separately
       exercised through these same public entries by the integration controls. */
    request.operation=4;request.source_path=source;request.source_path_len=(uint32_t)strlen(source);
    id=0;
    if (restic_bridge_operation_directories_v1_start(&request,&options,source_fd,workspace_fd,workspace,(uint32_t)strlen(workspace),"[]",2,&id) || !id) return 30;
    if (close(workspace_fd) || dup2(other_fd,workspace_fd)!=workspace_fd || drain(id) || result->status || !same_fd(workspace_fd,&other_before)) return 31;
    if (close(source_fd) || close(workspace_fd) || close(state_fd) || close(other_fd) || close(regular_fd)) return 32;
    free(result);return 0;
}
