+func existingMetadataNode(name string, mode os.FileMode) *data.Node {
+	return &data.Node{Name: name, Type: data.NodeTypeFile, Mode: mode, UID: uint32(os.Geteuid()), GID: uint32(os.Getegid()),
+		AccessTime: time.Unix(1700000000, 123456789), ModTime: time.Unix(1700000001, 987654321)}
+}
