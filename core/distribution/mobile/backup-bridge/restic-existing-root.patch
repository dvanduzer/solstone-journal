+func TestExistingRootMetadataGuardAndSymlinkDoNotFollowOutsideTarget(t *testing.T) {
+	path, writer := existingRootTestWriter(t)
+	if err := os.WriteFile(filepath.Join(path, "file"), []byte("data"), 0640); err != nil {
+		t.Fatal(err)
+	}
+	info, _ := os.Stat(filepath.Join(path, "file"))
+	writer.existingRoot.remember("file", info)
+	refusal := errors.New("metadata guard refused")
+	res := &Restorer{root: writer.root, existingRoot: writer.existingRoot, BeforeWrite: func() error { return refusal }}
+	if err := rootRestoreMetadata(res, existingMetadataNode("file", 0600), "file", nil, nil, false); !errors.Is(err, refusal) {
+		t.Fatalf("metadata skipped guard: %v", err)
+	}
+	after, _ := os.Stat(filepath.Join(path, "file"))
+	if after.Mode() != info.Mode() || !after.ModTime().Equal(info.ModTime()) {
+		t.Fatal("refused metadata changed")
+	}
+	outside := filepath.Join(t.TempDir(), "outside")
+	if err := os.WriteFile(outside, []byte("outside"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	outsideInfo, _ := os.Stat(outside)
+	if err := os.Symlink(outside, filepath.Join(path, "link")); err != nil {
+		t.Fatal(err)
+	}
+	res.BeforeWrite = func() error { return nil }
+	node := existingMetadataNode("link", 0777)
+	node.Type = data.NodeTypeSymlink
+	if err := rootRestoreMetadata(res, node, "link", nil, nil, false); err != nil {
+		t.Fatal(err)
+	}
+	outsideAfter, _ := os.Stat(outside)
+	if !outsideAfter.ModTime().Equal(outsideInfo.ModTime()) || outsideAfter.Mode() != outsideInfo.Mode() {
+		t.Fatal("symlink metadata followed outside target")
+	}
+	linkInfo, _ := os.Lstat(filepath.Join(path, "link"))
+	if !linkInfo.ModTime().Equal(node.ModTime) {
+		t.Fatal("symlink timestamp not restored")
+	}
+	// Exercise descriptor xattrs on an ordinary target independently of times.
+	name := "user.solstone.rooted"
+	if runtime.GOOS == "darwin" {
+		name = "com.solstone.rooted"
+	}
+	res.BeforeWrite = func() error { return nil }
+	fileNode := existingMetadataNode("file", 0600)
+	fileNode.ExtendedAttributes = []data.ExtendedAttribute{{Name: name, Value: []byte("owned")}}
+	if err := rootRestoreMetadata(res, fileNode, "file", nil, nil, false); err != nil {
+		t.Fatal(err)
+	}
+	buffer := make([]byte, 16)
+	n, err := unix.Getxattr(filepath.Join(path, "file"), name, buffer)
+	if err != nil || string(buffer[:n]) != "owned" {
+		t.Fatal("held descriptor xattr failed", err)
+	}
+}
