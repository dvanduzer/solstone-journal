+// Every case is a finite local entry substitution. The external go test
+// timeout bounds a regression that blocks in open(2); no competing process,
+// load generator or retry loop is used.
+func TestExistingRootClosedTypesRefuseWithoutBlocking(t *testing.T) {
+	operations := []string{"verify", "hardlink-source", "create", "reopen", "metadata-file", "metadata-directory", "metadata-symlink"}
+	for _, operation := range operations {
+		for _, kind := range []string{"fifo", "directory", "symlink"} {
+			if operation == "metadata-directory" && kind == "directory" || operation == "metadata-symlink" && kind == "symlink" {
+				continue
+			}
+			t.Run(operation+"/"+kind, func(t *testing.T) {
+				dir := t.TempDir()
+				outside := filepath.Join(t.TempDir(), "outside")
+				if err := os.WriteFile(outside, []byte("outside sentinel"), 0600); err != nil {
+					t.Fatal(err)
+				}
+				beforeOutside, err := os.Stat(outside)
+				if err != nil {
+					t.Fatal(err)
+				}
+				path := filepath.Join(dir, "entry")
+				if err := os.WriteFile(path, []byte("old data"), 0600); err != nil {
+					t.Fatal(err)
+				}
+				before, err := os.Stat(path)
+				if err != nil {
+					t.Fatal(err)
+				}
+				root, err := os.OpenRoot(dir)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer root.Close()
+				state := newExistingRootState()
+				state.remember("entry", before)
+				if err := os.Remove(path); err != nil {
+					t.Fatal(err)
+				}
+				switch kind {
+				case "fifo":
+					err = unix.Mkfifo(path, 0600)
+				case "directory":
+					err = os.Mkdir(path, 0700)
+				case "symlink":
+					err = os.Symlink(outside, path)
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				substituted, err := os.Lstat(path)
+				if err != nil {
+					t.Fatal(err)
+				}
+				nodeType := data.NodeTypeFile
+				if operation == "metadata-directory" {
+					nodeType = data.NodeTypeDir
+				}
+				if operation == "metadata-symlink" {
+					nodeType = data.NodeTypeSymlink
+				}
+				node := &data.Node{Name: "entry", Type: nodeType, Mode: 0600, UID: uint32(os.Geteuid()), GID: uint32(os.Getegid()), AccessTime: time.Unix(1700000000, 0), ModTime: time.Unix(1700000000, 0)}
+				res := &Restorer{root: root, existingRoot: state, BeforeWrite: func() error { return nil }}
+				writer := newFilesWriterRoot(1, false, root, func() error { return nil })
+				writer.existingRoot = state
+				var file *os.File
+				switch operation {
+				case "verify":
+					_, _, err = res.verifyFileRoot(context.Background(), root, "entry", node, false, false, nil)
+				case "hardlink-source":
+					err = checkExistingHardlinkSource(res, "entry")
+				case "create":
+					file, err = writer.createFileRoot("entry", 8, false)
+				case "reopen":
+					file, err = writer.openFileRoot("entry")
+				default:
+					err = rootRestoreMetadata(res, node, "entry", nil, nil, false)
+				}
+				if file != nil {
+					_ = file.Close()
+				}
+				writer.flush()
+				if err == nil {
+					t.Fatal("closed type was admitted")
+				}
+				after, statErr := os.Lstat(path)
+				if statErr != nil || !os.SameFile(substituted, after) || after.Mode() != substituted.Mode() {
+					t.Fatalf("refusal changed substituted entry: %v", statErr)
+				}
+				content, readErr := os.ReadFile(outside)
+				afterOutside, statErr := os.Stat(outside)
+				if readErr != nil || statErr != nil || string(content) != "outside sentinel" || afterOutside.Mode() != beforeOutside.Mode() || !afterOutside.ModTime().Equal(beforeOutside.ModTime()) {
+					t.Fatal("refusal changed outside sentinel")
+				}
+				t.Logf("refused %s as %s: %v", kind, operation, err)
+			})
+		}
+	}
+}
