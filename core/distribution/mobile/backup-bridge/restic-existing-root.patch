+func TestExistingRootMetadataUsesHeldInodeAndRefusesOutsideHardlink(t *testing.T) {
+	path, writer := existingRootTestWriter(t)
+	outside := filepath.Join(t.TempDir(), "outside")
+	if err := os.WriteFile(outside, []byte("outside bytes"), 0444); err != nil {
+		t.Fatal(err)
+	}
+	stamp := time.Unix(1600000000, 222000000)
+	if err := os.Chtimes(outside, stamp, stamp); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Link(outside, filepath.Join(path, "file")); err != nil {
+		t.Fatal(err)
+	}
+	before, err := os.Stat(outside)
+	if err != nil {
+		t.Fatal(err)
+	}
+	writer.existingRoot.remember("file", before)
+	res := &Restorer{root: writer.root, existingRoot: writer.existingRoot, BeforeWrite: func() error { return nil }}
+	node := existingMetadataNode("file", 0600)
+	if err := rootRestoreMetadata(res, node, "file", nil, nil, false); !errors.Is(err, errExistingIdentity) {
+		t.Fatalf("outside hardlink metadata admitted: %v", err)
+	}
+	after, err := os.Stat(outside)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !after.ModTime().Equal(before.ModTime()) || after.Mode() != before.Mode() {
+		t.Fatal("outside metadata changed")
+	}
+	value, _ := os.ReadFile(outside)
+	if string(value) != "outside bytes" {
+		t.Fatal("outside bytes changed")
+	}
+	// A full write detaches safely without chmodding the outside readonly inode.
+	if err := writer.writeToFile("file", []byte("new bytes"), 0, 9, false); err != nil {
+		t.Fatal(err)
+	}
+	if err := rootRestoreMetadata(res, node, "file", nil, nil, false); err != nil {
+		t.Fatal(err)
+	}
+	after, _ = os.Stat(outside)
+	if !after.ModTime().Equal(before.ModTime()) || after.Mode() != before.Mode() {
+		t.Fatal("detachment changed outside metadata")
+	}
+	value, _ = os.ReadFile(outside)
+	if string(value) != "outside bytes" {
+		t.Fatal("detachment changed outside bytes")
+	}
+	inside, _ := os.Stat(filepath.Join(path, "file"))
+	if os.SameFile(inside, after) || inside.Mode().Perm() != 0600 || !inside.ModTime().Equal(node.ModTime) {
+		t.Fatal("new inode metadata incorrect")
+	}
+}
